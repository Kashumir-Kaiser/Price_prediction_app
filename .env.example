# ═══════════════════════════════════════════════════════════════
#  Market Analysis Platform - Environment Configuration
#  Copy to .env and fill in all required values.
# ═══════════════════════════════════════════════════════════════

# ── Alpaca Markets API ──────────────────────────────────────
ALPACA_API_KEY=YOUR_ALPACA_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY_HERE
ALPACA_RATE_LIMIT_RPM=200                        # Requests per minute

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=market_db
POSTGRES_USER=market_user
POSTGRES_PASSWORD=change_me_in_production        # REQUIRED: Set a strong password

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── VN Stock (scraping) ─────────────────────────────────────
VNSTOCK_SLEEP_BETWEEN_TICKERS=2                  # Seconds between ticker fetches

# ── Authentication / Security ───────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_32_CHAR_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12                                 # Increase in production (14+)

# ── Admin Account ───────────────────────────────────────────
# These are ONLY used by seed_admin.py on first startup to create
# the initial admin account. After that, the password is stored
# as a bcrypt hash in the DB (seed_admin.py is idempotent).
# Changing ADMIN_PASSWORD in .env does NOT update an existing
# admin's password. To force re-seed: delete the admin row from
# the users table and restart the service.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@stockapp.internal
ADMIN_PASSWORD=                                  # REQUIRED: No default -- must be set!

# ── Application ─────────────────────────────────────────────
API_KEY=internal_x_api_key_for_frontend          # Internal service API key
LOG_LEVEL=INFO
ENVIRONMENT=development                          # development | production

# ── ML / Model Cache ────────────────────────────────────────
MODEL_CACHE_DIR=/model-cache
MODEL_BASE_URL=https://model-z.internal/download
DEVICE=cpu                                       # cpu | cuda | auto
