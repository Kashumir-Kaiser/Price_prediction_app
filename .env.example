# Alpaca Markets (free tier)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=market_db
POSTGRES_USER=market_user
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_URL=redis://redis:6379/0

# Application
API_KEY=internal_x_api_key_for_frontend
LOG_LEVEL=INFO
ENVIRONMENT=development

# ML / Model Cache
MODEL_CACHE_DIR=/model-cache
# MODEL_BASE_URL=https://your-bucket.s3.amazonaws.com/models/

# Rate Limiting
ALPACA_RATE_LIMIT_RPM=200
VNSTOCK_SLEEP_BETWEEN_TICKERS=2

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost/api
VITE_API_KEY=internal_x_api_key_for_frontend
